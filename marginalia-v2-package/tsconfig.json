{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "contracts/**/*.ts",
    "daemon/**/*.ts",
    "kernel/**/*.ts",
    "tests/**/*.ts",
    "fixtures/**/*.ts",
    "ui/**/*.ts",
    "webapp/**/*.ts",
    "renderer/**/*.ts",
    "extension/lib/anchors.d.ts"
  ]
}
